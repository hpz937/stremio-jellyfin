# How this container reaches Jellyfin. From a separate compose project, use the
# host's LAN address (or host.docker.internal on Docker Desktop).
JELLYFIN_URL=http://192.168.1.10:8096

# The address your TV/phone uses for Jellyfin. It goes into every stream link and
# poster. A LAN address works over WireGuard too, as long as the VPN routes your
# LAN subnet (AllowedIPs includes it). Defaults to JELLYFIN_URL.
# JELLYFIN_PUBLIC_URL=http://192.168.1.10:8096

# A dedicated, non-admin Jellyfin user. Its token is placed in stream links, so give
# it access only to the libraries you want here (Dashboard > Users > Access).
JELLYFIN_USERNAME=aiostreams
JELLYFIN_PASSWORD=change-me

# PORT=7000
# REFRESH_MINUTES=15
# LOG_LEVEL=info

# Maps Kitsu/MAL/AniList anime ids to TVDB seasons; downloaded once a day.
# Leave empty to turn off.
# ANIME_IDS_URL=https://raw.githubusercontent.com/Fribb/anime-lists/master/anime-list-full.json
